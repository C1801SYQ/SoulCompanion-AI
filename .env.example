# Reference only: copy does not load environment variables automatically.
# This release is a single-user, single-child local-only product.
SOULCOMPANION_APP_ENV=production
SOULCOMPANION_DEMO_MODE=false
SOULCOMPANION_DASHBOARD_HOST=127.0.0.1
SOULCOMPANION_DASHBOARD_PORT=8000
# Use an absolute path on your deployment machine:
# SOULCOMPANION_DB=/srv/soulcompanion/data/emotional_db.sqlite
SOULCOMPANION_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SOULCOMPANION_LOG_LEVEL=INFO
SOULCOMPANION_RATE_LIMIT=180
# Manual retention policy: 0 keeps all records. The maintenance CLI applies it
# only after explicit confirmation and a mandatory backup.
SOULCOMPANION_RETENTION_DAYS=0
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3n:e4b
# Total seconds per request, including connection, response headers and body.
# At most one retry on connection/timeout; response body is capped at 64 KiB.
OLLAMA_TIMEOUT=60
SOULCOMPANION_VISION_MODEL=models/onnx_model.onnx
SOULCOMPANION_HAAR_PATH=models/haarcascade_frontalface_default.xml
SOULCOMPANION_VOSK_PATH=model
SOULCOMPANION_SER_PATH=models/ser_model
