{
  "name": "soulcompanion-dashboard",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "python scripts/build_site.py --out .test-artifacts/site",
    "test": "node scripts/test_frontend.js",
    "test:demo": "node scripts/verify_demo.js",
    "test:e2e": "node scripts/browser_smoke.js",
    "lint": "node --check web/static/app.js && node --check web/static/demo-data.js && node --check scripts/test_frontend.js && node --check scripts/browser_smoke.js && node --check scripts/client_smoke.cjs && node --check scripts/client_audit.cjs && node --check scripts/test_client_audit.cjs && node --check apps/client/src/media/processors/pcm-worklet.js && node --check scripts/media_smoke.cjs && node --check scripts/cloud_browser.cjs",
    "client:build:h5": "npm --prefix apps/client run build:h5",
    "client:typecheck": "npm --prefix apps/client run typecheck",
    "client:test": "npm --prefix apps/client test",
    "client:audit": "node scripts/test_client_audit.cjs && node scripts/client_audit.cjs",
    "client:test:e2e": "node scripts/client_smoke.cjs",
    "client:test:media": "node scripts/media_smoke.cjs",
    "client:build:weapp": "npm --prefix apps/client run build:weapp",
    "cloud:test": "python -m pytest tests/cloud tests/cloud_tools -q -p no:cacheprovider",
    "cloud:plan": "python scripts/cloud_schema.py",
    "cloud:package": "python scripts/cloud_package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
