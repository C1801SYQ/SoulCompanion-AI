{
  "name": "@soulcompanion/client",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.10.1",
    "@taroify/core": "1.0.6",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "babel-preset-taro": "4.3.0",
    "postcss": "8.5.28",
    "react-refresh": "0.14.2",
    "sass": "1.93.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@tarojs/vite-runner": {
      "vite": "$vite",
      "vite-plugin-static-copy": "2.3.2"
    },
    "@tarojs/plugin-framework-react": {
      "vite": "$vite"
    },
    "@tarojs/plugin-doctor": {
      "glob": "10.5.0"
    },
    "@tarojs/helper": {
      "esbuild": "0.25.12"
    },
    "swiper": "12.1.2",
    "lodash-es": "4.18.1",
    "postcss": "$postcss",
    "adm-zip": "0.6.1",
    "glob@^10.4.1": "10.5.0",
    "http-cache-semantics": "4.2.0",
    "serialize-javascript": "7.1.2",
    "solid-js": "1.9.16",
    "seroval": "1.6.8"
  }
}
